Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Очищаем прежние движения: документ может перепроводиться.
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();

	// Сворачиваем табличную часть по товарам, чтобы не создавать дубли движений.
	ТаблицаТоваров = СписокТоваров.Выгрузить(, "Товар,Количество");
	ТаблицаТоваров.Свернуть("Товар", "Количество");

	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл

		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Товар = СтрокаТоваров.Товар;
		Движение.Склад = Склад;
		Движение.Количество = СтрокаТоваров.Количество;

	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Заполнение товара контролируется метаданными (проверка заполнения — «Ошибка»),
	// поэтому здесь проверяем только количество.
	НомерСтроки = 0;

	Для Каждого СтрокаТоваров Из СписокТоваров Цикл

		НомерСтроки = НомерСтроки + 1;

		Если СтрокаТоваров.Количество <= 0 Тогда
			Сообщить("В строке " + Строка(НомерСтроки) + ": количество должно быть больше нуля.");
			Отказ = Истина;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры
