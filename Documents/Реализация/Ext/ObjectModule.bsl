#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого СтрокаТовара Из СписокТоваровНаРеализацию Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.Товар) Тогда
			Сообщить("В строке №" + СтрокаТовара.НомерСтроки + " не указан товар.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТовара.Количество <= 0 Тогда
			Сообщить("В строке №" + СтрокаТовара.НомерСтроки + " количество должно быть больше нуля.");
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();
	
	Движения.ОборотыТоваров.Записывать = Истина;
	Движения.ОборотыТоваров.Очистить();
	
	ПроверитьДостаточностьОстатков(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьДвиженияРасхода();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

Процедура ПроверитьДостаточностьОстатков(Отказ)
	
	ТаблицаТоваровДляСписания = СписокТоваровНаРеализацию.Выгрузить(, "Товар, Количество");
	ТаблицаТоваровДляСписания.Свернуть("Товар", "Количество");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиТоваров.Товар КАК Товар,
	|	СУММА(ВЫБОР
	|			КОГДА ОстаткиТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА ОстаткиТоваров.Количество
	|			ИНАЧЕ -ОстаткиТоваров.Количество
	|		КОНЕЦ) КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров КАК ОстаткиТоваров
	|ГДЕ
	|	ОстаткиТоваров.Период <= &Дата
	|	И ОстаткиТоваров.Склад = &Склад
	|	И ОстаткиТоваров.Регистратор <> &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиТоваров.Товар";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	
	ОстаткиПоТоварам = Новый Соответствие;
	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл
		ОстаткиПоТоварам.Вставить(СтрокаОстатка.Товар, СтрокаОстатка.КоличествоОстаток);
	КонецЦикла;
	
	Для Каждого СтрокаТовара Из ТаблицаТоваровДляСписания Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		ОстатокНаСкладе = ОстаткиПоТоварам.Получить(СтрокаТовара.Товар);
		Если ОстатокНаСкладе = Неопределено Тогда
			ОстатокНаСкладе = 0;
		КонецЕсли;
		
		Если СтрокаТовара.Количество > ОстатокНаСкладе Тогда
			Сообщить("Недостаточно товара " + СтрокаТовара.Товар
				+ " на складе " + Склад + ". В наличии: " + ОстатокНаСкладе
				+ ", требуется: " + СтрокаТовара.Количество);
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьДвиженияРасхода()
	
	Для Каждого СтрокаТовара Из СписокТоваровНаРеализацию Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		ДвижениеОстаток = Движения.ОстаткиТоваров.Добавить();
		ДвижениеОстаток.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеОстаток.Период = Дата;
		ДвижениеОстаток.Товар = СтрокаТовара.Товар;
		ДвижениеОстаток.Склад = Склад;
		ДвижениеОстаток.Количество = СтрокаТовара.Количество;
		
		ДвижениеОборот = Движения.ОборотыТоваров.Добавить();
		ДвижениеОборот.Период = Дата;
		ДвижениеОборот.Товар = СтрокаТовара.Товар;
		ДвижениеОборот.Склад = Склад;
		ДвижениеОборот.КоличествоРасход = СтрокаТовара.Количество;
		ДвижениеОборот.Сумма = СтрокаТовара.Количество * СтрокаТовара.ЦенаНаРеализацию;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
