Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Очищаем прежние движения: документ может перепроводиться.
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();

	// Сворачиваем табличную часть по товарам, чтобы не создавать дубли движений.
	ТаблицаТоваров = СписокТоваровНаРеализацию.Выгрузить(, "Товар,Количество");
	ТаблицаТоваров.Свернуть("Товар", "Количество");

	Если Не ПроверитьОстатки(ТаблицаТоваров) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл

		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = СтрокаТоваров.Товар;
		Движение.Склад = Склад;
		Движение.Количество = СтрокаТоваров.Количество;

	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Количество должно быть положительным, иначе расход превратится в приход.
	НомерСтроки = 0;

	Для Каждого СтрокаТоваров Из СписокТоваровНаРеализацию Цикл

		НомерСтроки = НомерСтроки + 1;

		Если СтрокаТоваров.Количество <= 0 Тогда
			Сообщить("В строке " + Строка(НомерСтроки) + ": количество должно быть больше нуля.");
			Отказ = Истина;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ПроверитьОстатки(ТаблицаТоваров)

	// Считаем остатки по движениям на момент документа.
	// Текущий документ исключаем, чтобы перепроведение не давало ложного дефицита.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
|	ОстаткиТоваров.Товар КАК Товар,
|	СУММА(ВЫБОР
|			КОГДА ОстаткиТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
|				ТОГДА ОстаткиТоваров.Количество
|			ИНАЧЕ (0 - ОстаткиТоваров.Количество)
|		КОНЕЦ) КАК КоличествоОстаток
|ИЗ
|	РегистрНакопления.ОстаткиТоваров КАК ОстаткиТоваров
|ГДЕ
|	ОстаткиТоваров.Период <= &Дата
|	И ОстаткиТоваров.Склад = &Склад
|	И ОстаткиТоваров.Регистратор <> &Ссылка
|	И ОстаткиТоваров.Товар В (&СписокТоваров)
|СГРУППИРОВАТЬ ПО
|	ОстаткиТоваров.Товар";

	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("СписокТоваров", ТаблицаТоваров.ВыгрузитьКолонку("Товар"));

	ОстаткиПоТоварам = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		ОстаткиПоТоварам.Вставить(Выборка.Товар, Выборка.КоличествоОстаток);
	КонецЦикла;

	ОстаткиДостаточны = Истина;

	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл

		Остаток = ОстаткиПоТоварам.Получить(СтрокаТоваров.Товар);

		Если Остаток = Неопределено Тогда
			Остаток = 0;
		КонецЕсли;

		Если СтрокаТоваров.Количество > Остаток Тогда
			Сообщить("Недостаточно товара «" + Строка(СтрокаТоваров.Товар) + "» на складе «" + Склад
				+ "»: остаток " + Формат(Остаток, "ЧДЦ=2") + ", требуется " + Формат(СтрокаТоваров.Количество, "ЧДЦ=2") + ".",
				СтатусСообщения.Внимание);
			ОстаткиДостаточны = Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат ОстаткиДостаточны;

КонецФункции
