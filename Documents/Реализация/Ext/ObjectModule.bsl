Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();
	
	ТаблицаТоваров = СписокТоваровНаРеализацию.Выгрузить(, "Товар,Количество");
	ТаблицаТоваров.Свернуть("Товар", "Количество");
	
	// 1. Запрашиваем остатки
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОстаткиТоваров.Товар КАК Товар,
	|	СУММА(ВЫБОР
	|			КОГДА ОстаткиТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА ОстаткиТоваров.Количество
	|			ИНАЧЕ -ОстаткиТоваров.Количество
	|		КОНЕЦ) КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров КАК ОстаткиТоваров
	|ГДЕ
	|	ОстаткиТоваров.Период <= &Дата
	|	И ОстаткиТоваров.Склад = &Склад
	|	И ОстаткиТоваров.Регистратор <> &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиТоваров.Товар";   
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Ссылка", Ссылка); // Исключаем текущий документ из проверки
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаОстатков = РезультатЗапроса.Выгрузить();
	
	// 3. Проверяем, хватает ли товара
	Для Каждого СтрокаПродажи Из ТаблицаТоваров Цикл
		
		СтрокиОстатка = ТаблицаОстатков.НайтиСтроки(Новый Структура("Товар", СтрокаПродажи.Товар));
		
		Если СтрокиОстатка.Количество() > 0 Тогда
			Остаток = СтрокиОстатка[0].КоличествоОстаток;
		Иначе
			Остаток = 0; 
		КонецЕсли;
		
		Если СтрокаПродажи.Количество > Остаток Тогда
			Сообщить("Недостаточно товара " + СтрокаПродажи.Товар + " на складе " + Склад + 
			". В наличии: " + Остаток + ", требуется: " + СтрокаПродажи.Количество);
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат; 
	КонецЕсли;
	
	// 4. Записываем движения (Расход)
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = СтрокаТовара.Товар;
		Движение.Склад = Склад;
		Движение.Количество = СтрокаТовара.Количество;
	КонецЦикла;
	
КонецПроцедуры          


Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	// Проверяем, чтобы количество было строго больше нуля
	Для Каждого СтрокаТовары Из СписокТоваровНаРеализацию Цикл
		
		// Проверяем только заполненные строки, 
		Если СтрокаТовары.Товар <> Неопределено И НЕ СтрокаТовары.Товар.Пустая() Тогда
			
			Если СтрокаТовары.Количество <= 0 Тогда
				Сообщить("В строке №" + СтрокаТовары.НомерСтроки + " количество должно быть больше нуля!");
				Отказ = Истина;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

