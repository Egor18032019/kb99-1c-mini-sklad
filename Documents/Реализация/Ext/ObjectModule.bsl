#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    
    Движения.ОстаткиТоваров.Записывать = Истина;
    Движения.ОстаткиТоваров.Очистить();
    
    ПроверитьДостаточностьОстатков(Отказ);
    
    Если Отказ Тогда
        Возврат;
    КонецЕсли;
    
    СформироватьДвиженияРасхода();
    
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

Процедура ПроверитьДостаточностьОстатков(Отказ)
    
    ТаблицаТоваровДляСписания = СписокТоваровНаРеализацию.Выгрузить(, "Товар,Количество");
    ТаблицаТоваровДляСписания.Свернуть("Товар", "Количество");
    
    Запрос = Новый Запрос;
    // Пункт 2: Использована виртуальная таблица Остатки с параметром Регистратор
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	ОстаткиТоваровОстатки.Товар КАК Товар,
        |	ОстаткиТоваровОстатки.КоличествоОстаток КАК КоличествоОстаток
        |ИЗ
        |	РегистрНакопления.ОстаткиТоваров.Остатки(
        |		&Дата,
        |		Склад = &Склад
        |			И Регистратор <> &Ссылка
        |	) КАК ОстаткиТоваровОстатки";
    
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("Склад", Склад);
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    
    ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
    
    // Пункт 3: Строим Соответствие для быстрого поиска (O(1) вместо O(N))
    ОстаткиПоТоварам = Новый Соответствие;
    Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл
        ОстаткиПоТоварам.Вставить(СтрокаОстатка.Товар, СтрокаОстатка.КоличествоОстаток);
    КонецЦикла;
    
    Для Каждого ТекущаяСтрокаТоваров Из ТаблицаТоваровДляСписания Цикл
        
        // Пункт 4: Использование ЗначениеЗаполнено
        Если НЕ ЗначениеЗаполнено(ТекущаяСтрокаТоваров.Товар) Тогда
            Продолжить;
        КонецЕсли;
        
        ОстатокНаСкладе = ОстаткиПоТоварам.Получить(ТекущаяСтрокаТоваров.Товар);
        
        Если ОстатокНаСкладе = Неопределено Тогда
            ОстатокНаСкладе = 0;
        КонецЕсли;
        
        Если ТекущаяСтрокаТоваров.Количество > ОстатокНаСкладе Тогда
            Сообщить("Недостаточно товара " + ТекущаяСтрокаТоваров.Товар + " на складе " + Склад + 
                ". В наличии: " + ОстатокНаСкладе + ", требуется: " + ТекущаяСтрокаТоваров.Количество);
            Отказ = Истина;
        КонецЕсли;
        
    КонецЦикла;
    
КонецПроцедуры

Процедура СформироватьДвиженияРасхода()
    
    ТаблицаТоваровДляСписания = СписокТоваровНаРеализацию.Выгрузить(, "Товар,Количество");
    ТаблицаТоваровДляСписания.Свернуть("Товар", "Количество");
    
    Для Каждого ТекущаяСтрокаТоваров Из ТаблицаТоваровДляСписания Цикл
        
        Если НЕ ЗначениеЗаполнено(ТекущаяСтрокаТоваров.Товар) Тогда
            Продолжить;
        КонецЕсли;
        
        НовоеДвижение = Движения.ОстаткиТоваров.Добавить();
        НовоеДвижение.ВидДвижения = ВидДвиженияНакопления.Расход;
        НовоеДвижение.Период = Дата;
        НовоеДвижение.Товар = ТекущаяСтрокаТоваров.Товар;
        НовоеДвижение.Склад = Склад;
        НовоеДвижение.Количество = ТекущаяСтрокаТоваров.Количество;
        
    КонецЦикла;
    
КонецПроцедуры

#КонецОбласти