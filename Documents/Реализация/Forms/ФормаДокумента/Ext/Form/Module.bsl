#Область ОбработчикиСобытий

&НаКлиенте
Процедура СписокТоваровНаРеализациюЦенаНаРеализациюПриИзменении(Элемент)
	ПересчитатьСтроку();
КонецПроцедуры

&НаКлиенте
Процедура СписокТоваровНаРеализациюКоличествоПриИзменении(Элемент)
	ПересчитатьСтроку();
КонецПроцедуры

&НаКлиенте
Процедура СписокТоваровНаРеализациюПослеУдаления(Элемент)
	Объект.СуммаДокумента = Объект.СписокТоваровНаРеализацию.Итог("Сумма");
КонецПроцедуры

&НаКлиенте
Процедура СписокТоваровНаРеализациюПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если Копирование Тогда
		Объект.СуммаДокумента = Объект.СписокТоваровНаРеализацию.Итог("Сумма");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

&НаКлиенте
Процедура ПересчитатьСтроку()
	ТекущаяСтрока = Элементы.СписокТоваровНаРеализацию.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		// Защита от пустых значений
		Если ТекущаяСтрока.ЦенаНаРеализацию = Неопределено Тогда
			ТекущаяСтрока.ЦенаНаРеализацию = 0;
		КонецЕсли;

		Если ТекущаяСтрока.Количество = Неопределено Тогда
			ТекущаяСтрока.Количество = 0;
		КонецЕсли;

		ТекущаяСтрока.Сумма = ТекущаяСтрока.ЦенаНаРеализацию * ТекущаяСтрока.Количество;
		Объект.СуммаДокумента = Объект.СписокТоваровНаРеализацию.Итог("Сумма");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Печать

&НаКлиенте
Процедура Печать(Команда)
	ТабличныйДокумент = СформироватьПечатнуюФормуНаСервере();
	ТабличныйДокумент.Показать("Реализация " + Объект.Номер);
КонецПроцедуры

&НаСервере
Функция СформироватьПечатнуюФормуНаСервере()

	Макет = Документы.Реализация.ПолучитьМакет("Печать");
	ТабличныйДокумент = Новый ТабличныйДокумент;

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Номер = Объект.Номер;
	ОбластьШапка.Параметры.Дата = Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.Контрагент = Строка(Объект.Контрагент);
	ОбластьШапка.Параметры.Склад = Строка(Объект.Склад);
	ТабличныйДокумент.Вывести(ОбластьШапка);

	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);

	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	Для Каждого СтрокаТовара Из Объект.СписокТоваровНаРеализацию Цикл
		ОбластьСтрока.Параметры.НомерСтроки = СтрокаТовара.НомерСтроки;
		ОбластьСтрока.Параметры.Товар = Строка(СтрокаТовара.Товар);
		ОбластьСтрока.Параметры.Количество = СтрокаТовара.Количество;
		ОбластьСтрока.Параметры.Цена = СтрокаТовара.ЦенаНаРеализацию;
		ОбластьСтрока.Параметры.Сумма = СтрокаТовара.Сумма;
		ТабличныйДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;

	ОбластьИтого = Макет.ПолучитьОбласть("Итого");
	ОбластьИтого.Параметры.Итого = Объект.СуммаДокумента;
	ТабличныйДокумент.Вывести(ОбластьИтого);

	ТабличныйДокумент.ТолькоПросмотр = Истина;
	Возврат ТабличныйДокумент;

КонецФункции

#КонецОбласти
