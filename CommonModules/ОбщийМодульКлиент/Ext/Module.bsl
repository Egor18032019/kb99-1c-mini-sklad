Процедура ПересчитатьСуммуСтроки(Форма, ИмяТаблицы, ИмяРеквизитаЦены, ИмяРеквизитаСуммы) Экспорт

	// Получаем текущую строку по имени таблицы, переданному из формы
	ТекущаяСтрока = Форма.Элементы[ИмяТаблицы].ТекущиеДанные;

	Если ТекущаяСтрока <> Неопределено Тогда

		// Берем цену по переданному имени реквизита
		Цена = ТекущаяСтрока[ИмяРеквизитаЦены];

		Если Цена = Неопределено Тогда
			Цена = 0;
		КонецЕсли;

		Если ТекущаяСтрока.Количество = Неопределено Тогда
			ТекущаяСтрока.Количество = 0;
		КонецЕсли;

		// Записываем сумму
		ТекущаяСтрока[ИмяРеквизитаСуммы] = Цена * ТекущаяСтрока.Количество;

		// Пересчитываем итог в шапке документа
		Форма.Объект.СуммаДокумента = Форма.Объект[ИмяТаблицы].Итог(ИмяРеквизитаСуммы);

	КонецЕсли;

КонецПроцедуры