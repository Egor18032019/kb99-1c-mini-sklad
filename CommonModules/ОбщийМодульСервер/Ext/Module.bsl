Процедура ПроверитьДостаточностьОстатков(Документ, ИмяТаблицыТоваров, Отказ) Экспорт 
	
	// Динамически получаем нужную табличную часть документа
	ТаблицаТоваров = Документ[ИмяТаблицыТоваров];
	
	СвернутыеТоварыДляСписания = ТаблицаТоваров.Выгрузить(, "Товар, Количество");
	СвернутыеТоварыДляСписания.Свернуть("Товар", "Количество");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиТоваров.Товар КАК Товар,
	|	СУММА(ВЫБОР
	|			КОГДА ОстаткиТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА ОстаткиТоваров.Количество
	|			ИНАЧЕ -ОстаткиТоваров.Количество
	|		КОНЕЦ) КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров КАК ОстаткиТоваров
	|ГДЕ
	|	ОстаткиТоваров.Период <= &Дата
	|	И ОстаткиТоваров.Склад = &Склад
	|	И ОстаткиТоваров.Регистратор <> &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиТоваров.Товар";	
	
	Запрос.УстановитьПараметр("Дата", Документ.Дата);
	Запрос.УстановитьПараметр("Склад", Документ.Склад);
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	
	ОстаткиПоТоварамНаСкладе = Новый Соответствие;
	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл
		ОстаткиПоТоварамНаСкладе.Вставить(СтрокаОстатка.Товар, СтрокаОстатка.КоличествоОстаток);
	КонецЦикла;
	
	Для Каждого СтрокаТовара Из СвернутыеТоварыДляСписания Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТовара.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		ОстатокНаСкладе = ОстаткиПоТоварамНаСкладе.Получить(СтрокаТовара.Товар);
		Если ОстатокНаСкладе = Неопределено Тогда
			ОстатокНаСкладе = 0;
		КонецЕсли;
		
		Если СтрокаТовара.Количество > ОстатокНаСкладе Тогда
			Сообщить("Недостаточно товара " + Строка(СтрокаТовара.Товар) +
			" на складе " + Строка(Документ.Склад) +
			". В наличии: " + ОстатокНаСкладе + ", требуется: " + СтрокаТовара.Количество);
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
