# Автоматически определять текстовые файлы и нормализовать их
* text=auto

# Для конфигураций 1С принудительно используем LF
*.xml text eol=lf
*.bsl text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.json text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Git-хуки должны оставаться LF (иначе sh не прочитает shebang)
.githooks/* text eol=lf